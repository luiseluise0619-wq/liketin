NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/datingapp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (generate with: openssl rand -hex 32)
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret

# Firebase (base64 of the service account JSON). Leave empty to disable Firebase.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Payments (Stripe). Leave empty to run payments in SANDBOX mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Client origin for CORS
CLIENT_URL=http://localhost:8080
